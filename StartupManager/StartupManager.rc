// StartupManager.rc - Application resources
#include "resource.h"
#include <winres.h>
#include "afxres.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDR_MAINFRAME ICON "StartupManager.ico"

STRINGTABLE
BEGIN
    AFX_IDS_APP_TITLE "Startup Manager"
END

// -------------------------------------------------------------------------
// IDD_STARTUPMANAGER  (CStartupManagerDialog)
// -------------------------------------------------------------------------
IDD_STARTUPMANAGER DIALOGEX 0, 0, 400, 258
STYLE DS_SETFONT | WS_MINIMIZEBOX | WS_MAXIMIZEBOX |
      WS_SIZEBOX | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
EXSTYLE WS_EX_APPWINDOW
CAPTION "Startup Manager"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_SM_LIST, "SysListView32",
                    LVS_REPORT|LVS_SHOWSELALWAYS|WS_BORDER|WS_CHILD|WS_VISIBLE|WS_TABSTOP,
                    5, 5, 391, 217
    PUSHBUTTON      "Add Entry...",  IDC_SM_BTN_ADD,       5, 230,  57, 17
    PUSHBUTTON      "Delete",        IDC_SM_BTN_DELETE,   66, 230,  57, 17
    PUSHBUTTON      "Enable/Disable",IDC_SM_BTN_TOGGLE,  128, 230,  74, 17
    PUSHBUTTON      "Refresh",       IDC_SM_BTN_REFRESH, 207, 230,  57, 17
    PUSHBUTTON      "Close",         IDC_SM_BTN_CLOSE,   338, 230,  57, 17
    LTEXT           "", IDC_SM_STATIC_STATUS, 5, 247, 391, 10
END

// -------------------------------------------------------------------------
// IDD_ADDSTARTUPENTRY  (CAddStartupEntryDialog)  — fixed-size, no resize
// -------------------------------------------------------------------------
IDD_ADDSTARTUPENTRY DIALOGEX 0, 0, 240, 121
STYLE DS_SETFONT | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Add Startup Entry"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Name:",    IDC_AS_STATIC_NAME,  9,  14,  41, 12
    EDITTEXT        IDC_AS_EDIT_NAME,                53,  14, 178, 12, ES_AUTOHSCROLL
    LTEXT           "Command:", IDC_AS_STATIC_CMD,    9,  34,  41, 12
    EDITTEXT        IDC_AS_EDIT_CMD,                 53,  34, 139, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_AS_BTN_BROWSE, 195,  34,  35, 12
    LTEXT           "Hive:", IDC_STATIC,              9,  59,  40,  9
    AUTORADIOBUTTON "HKCU (current user)", IDC_AS_RADIO_HKCU,  53, 57,  94, 14, WS_GROUP
    AUTORADIOBUTTON "HKLM (all users)",    IDC_AS_RADIO_HKLM, 152, 57,  79, 14
    AUTOCHECKBOX    "Run once (delete after first run)", IDC_AS_CHK_RUNONCE,  9, 76, 222, 12
    PUSHBUTTON      "Add",    IDC_AS_BTN_ADD,    159, 101, 34, 12
    PUSHBUTTON      "Cancel", IDC_AS_BTN_CANCEL, 198, 101, 33, 12
END

// -------------------------------------------------------------------------
// Version info
// -------------------------------------------------------------------------
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Videalert"
            VALUE "FileDescription",  "StartupManager"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "StartupManager"
            VALUE "OriginalFilename", "StartupManager.exe"
            VALUE "ProductName",      "StartupManager"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
